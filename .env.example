# Database
DATABASE_URL="postgresql://user:password@localhost:5432/desk_booking?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Rate Limiting (optional, for production)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Admin Setup (first admin user)
ADMIN_EMAIL="admin@company.com"
ADMIN_PASSWORD="ChangeMe123!"

# Cron auth (Vercel sends this automatically as a Bearer token on scheduled
# runs once set — see vercel.json `crons` and pages/api/cron/keep-alive.ts).
# Generate with: openssl rand -base64 32
CRON_SECRET=""
